  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-XXXXXXXXXX');
  </script>
  -->

  <style>
    @font-face {
      font-family: 'Horev CLM';
      src: url('assets/fonts/HorevCLM-Heavy.ttf') format('truetype');
      font-weight: 900;
      font-style: normal;
      font-display: swap;
    }

    :root {
      --bg-primary: #0A0A0A;
      --bg-secondary: #111111;
      --bg-card: #1A1A1A;
      --accent: #FF4500;
      --accent-light: #FF6B35;
      --accent-gold: #FFB347;
      --text-primary: #FFFFFF;
      --text-secondary: #CCCCCC;
      --text-tertiary: #888888;
      --border: #222222;
      --gradient-hero: linear-gradient(135deg, #FF4500 0%, #FF6B35 50%, #FFB347 100%);
      --font-heading: 'Horev CLM', 'Arial Hebrew', sans-serif;
      --font-body: 'Inter', sans-serif;
      --nav-height: 80px;
      --glass: rgba(26, 26, 26, 0.55);
      --glass-border: rgba(255, 69, 0, 0.22);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html {
      scroll-behavior: smooth;
      -webkit-text-size-adjust: 100%;
    }

    body {
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.6;
      color: var(--text-secondary);
      background: var(--bg-primary);
      overflow-x: hidden;
    }

    img, video { max-width: 100%; height: auto; display: block; }

    /* Hero portrait overrides global img sizing */
    .hero__portrait,
    .hero__visual-video {
      max-width: none;
    }

    a { color: inherit; text-decoration: none; }

    .container {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }

    h1, h2, h3 {
      font-family: var(--font-heading);
      font-weight: 900;
      color: var(--text-primary);
      line-height: 1.15;
      letter-spacing: -0.01em;
    }

    h1 { font-size: clamp(48px, 8vw, 88px); }
    h2 { font-size: clamp(30px, 4.5vw, 46px); }
    h3 { font-size: clamp(26px, 3.4vw, 38px); }

    h1 em, h2 em, h3 em,
    .hero__title em,
    .section-title em,
    .mentor-content h2 em,
    .final-cta h2 em {
      font-family: inherit;
      font-style: normal;
      font-weight: inherit;
      color: inherit;
      -webkit-text-fill-color: unset;
    }

    .section {
      padding: 80px 0;
      position: relative;
    }

    .section__header {
      text-align: center;
      margin-bottom: 48px;
    }

    .section__eyebrow {
      display: inline-block;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 12px;
    }

    .section__subtitle {
      max-width: 640px;
      margin: 16px auto 0;
      color: var(--text-tertiary);
      font-size: 17px;
    }

    /* Navbar */
    .navbar {
      position: fixed;
      top: 0;
      right: 0;
      left: 0;
      z-index: 900;
      height: var(--nav-height);
      display: flex;
      align-items: center;
      transition: background 0.3s ease, backdrop-filter 0.3s ease, border-color 0.3s ease;
      border-bottom: 1px solid transparent;
    }

    .navbar.is-scrolled {
      background: rgba(10, 10, 10, 0.72);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-color: rgba(255, 255, 255, 0.06);
    }

    .navbar__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }

    .navbar__logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: var(--font-heading);
      font-size: 20px;
      font-weight: 700;
      color: var(--text-primary);
    }

    .navbar__logo-icon {
      width: 36px;
      height: 36px;
      background: var(--gradient-hero);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .navbar__logo-icon svg { width: 20px; height: 20px; }

    .navbar__nav {
      display: none;
      gap: 32px;
      list-style: none;
    }

    .navbar__nav a {
      font-size: 14px;
      font-weight: 500;
      color: var(--text-secondary);
      transition: color 0.2s;
    }

    .navbar__nav a:hover { color: var(--accent); }

    @media (min-width: 768px) {
      .navbar__nav { display: flex; }
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 16px 32px;
      border-radius: 10px;
      font-family: var(--font-heading);
      font-weight: 900;
      font-size: 18px;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.3s ease;
      border: none;
      white-space: nowrap;
    }

    .btn--primary {
      background: var(--accent);
      color: #FFFFFF;
      box-shadow: 0 0 20px rgba(255, 69, 0, 0.4);
    }

    .btn--primary:hover {
      background: var(--accent-light);
      box-shadow: 0 0 30px rgba(255, 69, 0, 0.6);
      transform: translateY(-2px);
    }

    .btn--ghost {
      background: #FFFFFF;
      color: #0A0A0A;
      box-shadow: 0 8px 32px rgba(255, 255, 255, 0.12);
    }

    .btn--ghost:hover {
      background: #F5F5F5;
      box-shadow: 0 12px 40px rgba(255, 255, 255, 0.2);
      transform: translateY(-2px);
    }

    .btn--outline {
      background: transparent;
      color: var(--text-primary);
      border: 1px solid rgba(255, 255, 255, 0.25);
      box-shadow: none;
    }

    .btn--outline:hover {
      border-color: var(--accent);
      color: var(--accent-light);
      box-shadow: 0 0 20px rgba(255, 69, 0, 0.2);
    }

    .btn--lg {
      padding: 20px 40px;
      font-size: 22px;
    }

    .btn svg { width: 22px; height: 22px; flex-shrink: 0; }

    /* Hero — full-bleed portrait background + content (RTL) */
    .hero {
      min-height: 100vh;
      min-height: 100dvh;
      position: relative;
      overflow: hidden;
      padding-top: var(--nav-height);
      background: var(--bg-primary);
    }

    .hero__bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .hero__bg-media {
      position: absolute;
      inset: -14% 0 -10% 0;
      width: 100%;
      height: 124%;
      will-change: transform;
    }

    .hero__bg-overlay {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(270deg, rgba(10, 10, 10, 0.97) 0%, rgba(10, 10, 10, 0.88) 28%, rgba(10, 10, 10, 0.45) 52%, rgba(10, 10, 10, 0.05) 72%, transparent 100%),
        linear-gradient(to top, rgba(10, 10, 10, 0.75) 0%, transparent 22%);
      z-index: 1;
    }

    @media (max-width: 959px) {
      .hero__bg-overlay {
        background:
          linear-gradient(to top, rgba(10, 10, 10, 0.98) 0%, rgba(10, 10, 10, 0.78) 38%, rgba(10, 10, 10, 0.15) 100%);
      }
    }

    .hero__grid {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      min-height: calc(100dvh - var(--nav-height));
      position: relative;
      z-index: 2;
    }

    /* Content — right side in RTL; portrait stays on the left */
    .hero__content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 48px 0 32px;
      position: relative;
      width: 100%;
      max-width: 560px;
    }

    .hero__visual-glow {
      position: absolute;
      width: min(520px, 60vw);
      height: min(520px, 60vw);
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 69, 0, 0.4) 0%, transparent 70%);
      top: 8%;
      left: 42%;
      transform: translateX(-50%);
      filter: blur(48px);
      pointer-events: none;
      animation: glow-pulse 4s ease-in-out infinite;
      z-index: 2;
    }

    @keyframes glow-pulse {
      0%, 100% { opacity: 0.65; transform: translateX(-50%) scale(1); }
      50% { opacity: 1; transform: translateX(-50%) scale(1.08); }
    }

    .hero__portrait {
      position: absolute;
      top: 0;
      left: 0;
      width: auto;
      height: 100%;
      max-width: none;
      min-height: 100%;
      object-fit: contain;
      object-position: left bottom;
    }

    @media (max-width: 959px) {
      .hero__portrait {
        right: 50%;
        transform: translateX(50%);
        height: 92%;
        top: auto;
        bottom: 0;
        object-position: center bottom;
      }
    }

    .hero__visual-video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 28% center;
      opacity: 0;
      transition: opacity 0.8s ease;
      pointer-events: none;
      mix-blend-mode: soft-light;
    }

    .hero.is-video-active .hero__visual-video {
      opacity: 0.35;
    }

    @media (prefers-reduced-motion: reduce) {
      .hero__visual-video { display: none; }
      .hero__bg-media { transform: none !important; }
    }

    /* Content side */
    @media (min-width: 960px) {
      .hero__content {
        padding: 60px 0;
      }
    }

    .hero__greeting {
      font-size: 15px;
      color: var(--text-tertiary);
      margin-bottom: 20px;
      line-height: 1.7;
      max-width: 420px;
    }

    .hero__greeting strong {
      color: var(--text-secondary);
      font-weight: 500;
    }

    .hero__eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 16px;
      background: transparent;
      border: 1px solid rgba(255, 69, 0, 0.45);
      border-radius: 100px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--accent-light);
      margin-bottom: 20px;
      width: fit-content;
    }

    .hero__title {
      margin-bottom: 20px;
      font-size: clamp(48px, 8.5vw, 92px);
      line-height: 0.92;
    }

    .hero__title em {
      display: block;
      font-size: 0.88em;
      margin-top: 0;
      line-height: 0.95;
      color: var(--accent-light);
    }

    .hero__tagline {
      font-size: 14px;
      color: var(--accent-light);
      letter-spacing: 0.06em;
      margin-bottom: 28px;
    }

    .hero__subtitle {
      font-size: clamp(15px, 2vw, 17px);
      color: var(--text-tertiary);
      margin-bottom: 32px;
      max-width: 460px;
      line-height: 1.75;
    }

    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      align-items: center;
      margin-bottom: 36px;
    }

    .hero__avatars {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .hero__avatars-stack {
      display: flex;
    }

    .hero__avatars-stack img {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 2px solid var(--bg-primary);
      margin-right: -10px;
      object-fit: cover;
    }

    .hero__avatars-stack img:last-child { margin-right: 0; }

    .hero__avatars-text {
      font-size: 13px;
      color: var(--text-tertiary);
    }

    .hero__stats-row {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
    }

    .hero__stat-card {
      flex: 1;
      min-width: 130px;
      padding: 18px 20px;
      background: var(--glass);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--glass-border);
      border-radius: 14px;
      transition: border-color 0.3s, transform 0.3s;
    }

    .hero__stat-card:hover {
      border-color: rgba(255, 69, 0, 0.5);
      transform: translateY(-2px);
    }

    .hero__stat-number {
      font-family: var(--font-heading);
      font-size: clamp(28px, 4vw, 38px);
      font-weight: 700;
      color: var(--accent);
      line-height: 1;
    }

    .hero__stat-label {
      font-size: 12px;
      color: var(--text-tertiary);
      margin-top: 6px;
    }

    /* Floating testimonial card */
    .hero__float-card {
      display: none;
      position: absolute;
      bottom: 48px;
      right: 32px;
      left: auto;
      z-index: 5;
      max-width: 280px;
      padding: 18px 20px;
      background: rgba(255, 255, 255, 0.95);
      border-radius: 16px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
      color: #0A0A0A;
    }

    @media (min-width: 960px) {
      .hero__float-card { display: block; }
    }

    .hero__float-card p {
      font-size: 13px;
      line-height: 1.6;
      color: #333;
      margin-bottom: 12px;
    }

    .hero__float-author {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .hero__float-author img {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
    }

    .hero__float-name {
      font-size: 13px;
      font-weight: 600;
      color: #0A0A0A;
    }

    .hero__float-role {
      font-size: 11px;
      color: #666;
    }

    /* Partners strip */
    .hero__partners {
      position: relative;
      z-index: 2;
      padding: 24px 0 40px;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .hero__partners-label {
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-tertiary);
      text-align: center;
      margin-bottom: 16px;
    }

    .hero__partners-logos {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 28px 40px;
      opacity: 0.45;
    }

    .hero__partners-logos span {
      font-family: var(--font-heading);
      font-size: 14px;
      font-weight: 600;
      color: var(--text-secondary);
      letter-spacing: 0.02em;
    }

    /* Mentor section — Meet the minds */
    .mentor-section {
      background: var(--bg-primary);
      overflow: hidden;
    }

    .mentor-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 48px;
      align-items: center;
    }

    @media (min-width: 960px) {
      .mentor-grid {
        grid-template-columns: 1fr 1.1fr;
        gap: 64px;
      }
    }

    .mentor-photo {
      position: relative;
      border-radius: 20px;
      overflow: hidden;
      aspect-ratio: 3/4;
      max-height: 520px;
      border: 1px solid var(--glass-border);
    }

    .mentor-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .mentor-photo__glow {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(10,10,10,0.85) 0%, transparent 45%);
      pointer-events: none;
    }

    .mentor-content > p {
      font-size: 16px;
      line-height: 1.75;
      color: var(--text-tertiary);
      margin: 20px 0 32px;
      max-width: 520px;
    }

    .mentor-cards {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
    }

    @media (min-width: 640px) {
      .mentor-cards { grid-template-columns: 1fr 1fr; }
    }

    .mentor-card {
      padding: 24px;
      background: var(--glass);
      backdrop-filter: blur(12px);
      border: 1px solid var(--glass-border);
      border-radius: 16px;
      transition: border-color 0.3s;
    }

    .mentor-card:hover { border-color: rgba(255, 69, 0, 0.5); }

    .mentor-card__img {
      width: 100%;
      height: 100px;
      border-radius: 10px;
      object-fit: cover;
      margin-bottom: 14px;
    }

    .mentor-card__stat {
      font-family: var(--font-heading);
      font-size: 28px;
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 4px;
    }

    .mentor-card .btn {
      margin-top: 16px;
      width: 100%;
    }

    /* Video Section */
    .video-section {
      background: var(--bg-secondary);
    }

    .video-wrapper {
      position: relative;
      width: 100%;
      padding-bottom: 56.25%;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid rgba(255, 69, 0, 0.25);
      background: var(--bg-card);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }

    .video-wrapper iframe,
    .video-wrapper video,
    .video-wrapper .video-placeholder {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: none;
    }

    .video-placeholder {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      background:
        linear-gradient(to top, rgba(10,10,10,0.92) 0%, rgba(10,10,10,0.4) 50%, transparent 100%),
        url('assets/images/community.png') center/cover no-repeat;
      cursor: pointer;
    }

    .video-placeholder__play {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 30px rgba(255, 69, 0, 0.5);
      transition: transform 0.3s ease;
    }

    .video-placeholder:hover .video-placeholder__play {
      transform: scale(1.08);
    }

    .video-placeholder__play svg { width: 28px; height: 28px; margin-right: -3px; }

    .video-placeholder__text {
      font-size: 15px;
      color: var(--text-tertiary);
    }

    .video-summary {
      text-align: center;
      max-width: 680px;
      margin: 32px auto 0;
      font-size: 17px;
      line-height: 1.7;
    }

    .video-section .btn { display: flex; margin: 36px auto 0; width: fit-content; }

    /* Features */
    .features-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
    }

    @media (min-width: 640px) {
      .features-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (min-width: 1024px) {
      .features-grid { grid-template-columns: repeat(4, 1fr); }
    }

    .card {
      background: var(--glass);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--glass-border);
      border-radius: 16px;
      padding: 32px 24px;
      text-align: right;
      transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
      border-color: rgba(255, 69, 0, 0.8);
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(255, 69, 0, 0.12);
    }

    .card__icon {
      width: 56px;
      height: 56px;
      border-radius: 12px;
      background: rgba(255, 69, 0, 0.12);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
      font-size: 26px;
    }

    .card__title {
      font-family: var(--font-heading);
      font-size: clamp(24px, 2.8vw, 30px);
      font-weight: 900;
      color: var(--text-primary);
      margin-bottom: 8px;
    }

    .card__text {
      font-size: 15px;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    .features-section .btn { display: flex; margin: 48px auto 0; width: fit-content; }

    /* Roadmap */
    .roadmap-section { background: var(--bg-secondary); }

    .roadmap {
      display: flex;
      flex-direction: column;
      gap: 0;
      position: relative;
