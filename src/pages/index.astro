    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.884 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
  </a>

  <script>
    /* ===== Configuration — replace with client values ===== */
    const CONFIG = {
      whatsappPhone: '972501234567',
      whatsappMessage: 'שלום, אני מעוניין/ת ללמוד על תוכנית המסחר. הגעתי מהלנדינג.',
      heroVideoUrl: 'https://assets.mixkit.co/videos/preview/mixkit-stock-market-trends-on-a-computer-screen-4395-large.mp4',
      // Or self-hosted: 'assets/videos/hero-loop.mp4'
      videoUrl: '' // block 2 explainer — YouTube embed or mp4 with controls
    };

    /* ===== UTM params ===== */
    function getUtmParams() {
      const params = new URLSearchParams(window.location.search);
      const keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid', 'click_id'];
      return keys
        .filter(k => params.get(k))
        .map(k => `${k}=${params.get(k)}`)
        .join('&');
    }

    function buildWhatsAppUrl() {
      let text = CONFIG.whatsappMessage;
      const utms = getUtmParams();
      if (utms) text += '\n\n' + utms;
      return `https://wa.me/${CONFIG.whatsappPhone}?text=${encodeURIComponent(text)}`;
    }

    function initCtaButtons() {
      const waUrl = buildWhatsAppUrl();
      document.querySelectorAll('.cta-btn').forEach(btn => {
        btn.setAttribute('href', waUrl);
        btn.setAttribute('target', '_blank');
        btn.setAttribute('rel', 'noopener noreferrer');
        btn.addEventListener('click', () => {
          const block = btn.dataset.block || 'unknown';
          trackEvent('whatsapp_click', { block });
          /* Meta Pixel Lead event placeholder */
          if (typeof fbq === 'function') fbq('track', 'Lead', { content_name: block });
          if (typeof gtag === 'function') gtag('event', 'whatsapp_click', { event_category: 'CTA', event_label: block });
        });
      });
    }

    /* ===== Analytics helpers ===== */
    function trackEvent(name, params = {}) {
      if (typeof gtag === 'function') gtag('event', name, params);
    }

    /* ===== Navbar scroll effect ===== */
    function initNavbar() {
      const navbar = document.getElementById('navbar');
      const onScroll = () => navbar.classList.toggle('is-scrolled', window.scrollY > 40);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    /* ===== Scroll animations ===== */
    function animateOnScroll() {
      const observer = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.animate-on-scroll').forEach(el => observer.observe(el));
    }

    /* ===== Hero parallax ===== */
    function initHeroParallax() {
      const hero = document.getElementById('hero');
      const media = document.getElementById('hero-bg-media');
      if (!hero || !media) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) return;

      let ticking = false;
      const factor = 0.06;

      const update = () => {
        const rect = hero.getBoundingClientRect();
        if (rect.bottom <= 0 || rect.top >= window.innerHeight) {
          ticking = false;
          return;
        }
        const offset = Math.max(0, -rect.top) * factor;
        media.style.transform = `translate3d(0, ${offset}px, 0)`;
        ticking = false;
      };

      window.addEventListener('scroll', () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }, { passive: true });
      update();
    }

    /* ===== Hero background video (separate from block 2 explainer) ===== */
    function initHeroVideo() {
      const hero = document.getElementById('hero');
      const video = document.getElementById('hero-video');
      if (!hero || !video) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const saveData = navigator.connection && navigator.connection.saveData;
      const src = CONFIG.heroVideoUrl || video.dataset.src;

      if (!src || prefersReducedMotion || saveData) return;

      const startPlayback = () => {
        video.src = src;
        video.load();
        const playPromise = video.play();
        if (playPromise && typeof playPromise.catch === 'function') {
          playPromise.catch(() => {
            /* Autoplay blocked — poster stays visible, no layout shift */
          });
        }
      };

      const onReady = () => {
        hero.classList.add('is-video-active');
        trackEvent('hero_video_start');
      };

      video.addEventListener('playing', onReady, { once: true });
      video.addEventListener('error', () => {
        hero.classList.remove('is-video-active');
      });

      /* First screen: load immediately; poster shows until first frame */
      startPlayback();
    }

    /* ===== Block 2 explainer video lazy load ===== */
    function initVideo() {
      const container = document.getElementById('video-container');
      const placeholder = document.getElementById('video-placeholder');
      if (!CONFIG.videoUrl) {
        placeholder.addEventListener('click', () => {
          trackEvent('video_click', { action: 'placeholder' });
        });
        placeholder.addEventListener('keydown', e => {
          if (e.key === 'Enter' || e.key === ' ') placeholder.click();
        });
        return;
      }

      const observer = new IntersectionObserver(
        entries => {
          if (entries[0].isIntersecting) {
            loadVideo();
            observer.disconnect();
          }
        },
        { threshold: 0.25 }
      );
      observer.observe(container);

      function loadVideo() {
        placeholder.remove();
        if (CONFIG.videoUrl.includes('youtube') || CONFIG.videoUrl.includes('vimeo')) {
          const iframe = document.createElement('iframe');
          iframe.src = CONFIG.videoUrl + (CONFIG.videoUrl.includes('?') ? '&' : '?') + 'autoplay=0';
          iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
          iframe.allowFullscreen = true;
          iframe.title = 'סרטון הסבר';
          container.appendChild(iframe);
        } else {
          const video = document.createElement('video');
          video.src = CONFIG.videoUrl;
          video.controls = true;
          video.preload = 'metadata';
          video.playsInline = true;
          video.addEventListener('play', () => trackEvent('video_start'));
          video.addEventListener('ended', () => trackEvent('video_complete'));
          container.appendChild(video);
        }
      }

      placeholder.addEventListener('click', loadVideo);
    }

    /* ===== Scroll depth tracking ===== */
    function initScrollDepth() {
      const milestones = [25, 50, 75, 100];
      const reached = new Set();
      window.addEventListener('scroll', () => {
        const scrollPercent = Math.round(
          (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100
        );
        milestones.forEach(m => {
          if (scrollPercent >= m && !reached.has(m)) {
            reached.add(m);
            trackEvent('scroll_depth', { percent: m });
          }
        });
      }, { passive: true });
    }

    /* ===== Init ===== */
    document.addEventListener('DOMContentLoaded', () => {
      initCtaButtons();
      initNavbar();
      animateOnScroll();
      initHeroParallax();
      initHeroVideo();
      initVideo();
      initScrollDepth();
      trackEvent('page_view');
    });
  </script>
